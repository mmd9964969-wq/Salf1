# Farvahr Self — Railway / local environment
# Never commit real values. Set secrets in Railway Variables.

# Persistent PostgreSQL. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Telegram application credentials (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram bot created with @BotFather
SALF1_BOT_TOKEN=

# Encryption key for Telegram sessions stored in PostgreSQL.
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it unchanged after accounts have been connected.
SALF1_SESSION_ENCRYPTION_KEY=

# Server-side signing and internal Node <-> Python authentication secrets.
# Generate each independently with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
WORKER_API_TOKEN=
SALF1_WEBHOOK_SECRET=

# Telegram Login / OpenID Connect. The bot ID can be derived from SALF1_BOT_TOKEN.
# Set the client secret after configuring Telegram Login in @BotFather.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=

# Public URL settings. Set after creating the Railway domain.
PUBLIC_ORIGIN=
SALF1_LOGIN_BASE_URL=
RP_ID=

# Internal web-to-worker communication (same container).
SALF1_WORKER_URL=http://127.0.0.1:8080
SALF1_PORT=8080
PORT=4173

# Owner, admin and optional channel configuration.
SALF1_OWNER_USER_IDS=
SALF1_ADMIN_IDS=
SALF1_CREATOR_USERNAME=Jowati
SALF1_CHANNEL_USERNAME=

# Runtime role and bounded database pool.
SALF1_ROLE=all
SALF1_DB_POOL_MIN=1
SALF1_DB_POOL_MAX=8

# Optional event/payment integrations.
SALF1_EVENT_BRIDGE_URL=
SALF1_KEYWORD_ACK_URL=
SALF1_PAYMENT_URL=
SALF1_CARD_PAYMENT_URL=
SALF1_PAYMENT_SUPPORT_URL=

# Optional feature settings.
SALF1_LOGIN_TOKEN_TTL_SECONDS=600
SALF1_REFERRAL_REWARD=500
SALF1_TRIAL_HOURS=24
