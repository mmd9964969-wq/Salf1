# Required for persistent panel and bot data.
DATABASE_URL=

# Required for the Telegram bot and user-account login.
SALF1_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Must be at least 32 characters. Keep the same value used by the existing
# database; changing it makes previously encrypted Telegram sessions unreadable.
SALF1_SESSION_ENCRYPTION_KEY=

# Required for Telegram OIDC login on the web panel.
# The client ID can be inferred from SALF1_BOT_TOKEN, but the client secret
# must come from the Telegram login/OIDC configuration.
TELEGRAM_OIDC_CLIENT_SECRET=

# Optional configuration.
TELEGRAM_OIDC_CLIENT_ID=
SALF1_OWNER_USER_IDS=
SALF1_ADMIN_IDS=
SALF1_CREATOR_USERNAME=Jowati
SALF1_CHANNEL_USERNAME=Pers3anSelf
PUBLIC_ORIGIN=
RP_ID=
TELEGRAM_OIDC_REDIRECT_URI=
SALF1_EVENT_BRIDGE_URL=
SALF1_KEYWORD_ACK_URL=
SALF1_PAYMENT_URL=
SALF1_CARD_PAYMENT_URL=
SALF1_PAYMENT_SUPPORT_URL=
SALF1_ROLE=all
SALF1_DB_POOL_MIN=1
SALF1_DB_POOL_MAX=8

# SESSION_SECRET, WORKER_API_TOKEN, and SALF1_WEBHOOK_SECRET are generated
# and persisted by the Durable Object if they are not supplied as Worker secrets.
